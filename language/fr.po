msgstr "Aucune portée définie (contenus / objets numériques). Rien à faire."

#: src/Job/MediaDimensions.php:119
msgid "No item selected. You may check your query."
msgstr "Aucun contenu sélectionné. Vérifiez votre recherche."

#: src/Job/MediaDimensions.php:125
msgid "Starting bulk sizing for {total} items ({mode} media, scope: {scope})."
msgstr "Démarrage de la création des tailles en lot pour {total} contenus ({mode} média, portée : {scope})."

#: src/Job/MediaDimensions.php:146
